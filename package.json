{
  "name": "project-architect-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!frontend build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx --yes oxlint --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/dist/**\" packages apps tests",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
