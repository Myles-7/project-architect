    },
    {
      "id": "asm-mth5jkd0-8uuv",
      "area": "ux_ui_direction",
      "decisionKey": "avatar_sprite_format",
      "statement": "MVP 版本内置的虚拟形象动作动画以简单的 2D 序列帧或静态切图形式存在，通过替换图片源实现状态切换。",
      "reason": "首期内置形象能够降低资产制作门槛，确保能在移动端浏览器上轻量且快速加载。",
      "status": "resolved",
      "createdAt": "2026-08-31T11:25:33.780Z",
