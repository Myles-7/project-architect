    {
      "id": "asm-mth5603x-0nh0",
      "area": "ux_ui_direction",
      "decisionKey": "offline_visual_state",
      "statement": "当其中一方离线（关闭网页或断网）时，其虚拟形象在对方屏幕上自动切换为睡觉或在沙发上发呆的挂机动画。",
      "reason": "在本地优先（Local-First）和无干扰陪伴的定位下，网络连接断开是常态，用挂机动画代替人物消失能维持同居室的连贯和温馨氛围。",
      "status": "resolved",
      "createdAt": "2026-08-31T11:15:01.004Z",
