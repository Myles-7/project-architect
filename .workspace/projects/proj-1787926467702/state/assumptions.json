    {
      "id": "asm-mth5jkd0-u12i",
      "area": "technical_boundary",
      "decisionKey": "public_network_latency",
      "statement": "由于采用轻量 WebSocket 服务器或 WebRTC 直连，双方在不同网络环境下的实时状态同步延迟可以容忍在数秒之内。",
      "reason": "核心定位为“无干扰陪伴”而非高频竞技游戏，对亚秒级超低延迟没有强需求。",
      "status": "resolved",
      "createdAt": "2026-08-31T11:25:33.780Z",
