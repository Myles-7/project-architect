    {
      "id": "asm-mtd2f6qa-lnau",
      "area": "ux_ui_direction",
      "decisionKey": "initial_furniture_asset_source",
      "statement": "假设首个版本内置的像素风家具素材直接使用开源免费或免版税的素材包（如 Itch.io 上的像素风资源），而不是自己从零绘制。",
      "reason": "这可以极大减少前期在 UI 美工上的耗时，让我们能够全力聚焦在核心动作同步和装扮拖拽的功能逻辑上，且后续随时可以替换为自定义绘制的素材。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:47:05.938Z",
      "resolvedAt": "2026-08-28T14:49:16.815Z",
      "resolvedDecisionRef": "decision:dec-1787928556815-zezz",
      "linkedDecisionRefs": [
        "decision:dec-1787928556815-zezz"
      ]
    },
    {
      "id": "asm-mtd2f6qa-8836",
      "area": "technical_boundary",
      "decisionKey": "browser_compatibility",
      "statement": "假设只需兼容支持标准 HTML5 Drag and Drop API 和 WebSocket 协议的现代主流移动及桌面浏览器（如 Chrome、Safari、Edge），不考虑旧版浏览器的兼容。",
      "reason": "现代浏览器均已原生支持这些特性，限制在现代浏览器上能大幅简化网页交互和网络协议的开发工作，且情侣两人使用的设备一般都为现代主流设备。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:47:05.938Z",
      "resolvedAt": "2026-08-28T15:12:04.926Z",
      "resolvedDecisionRef": "decision:dec-1787929924926-kv27",
      "linkedDecisionRefs": [
        "decision:dec-1787929924926-kv27"
      ]
    },
    {
      "id": "asm-mtd2j21i-zwbv",
      "area": "ux_ui_direction",
      "decisionKey": "default_room_layout",
      "statement": "MVP 首期仅提供 1 个默认房间布局和 5-10 件基础像素家具，暂不支持多房间切换。",
      "reason": "通过提供预设的初始房间和极简的家具，可以降低首期美术资源的复杂度，帮助快速验证拖拽和动作同步的核心玩法。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:50:06.485Z",
