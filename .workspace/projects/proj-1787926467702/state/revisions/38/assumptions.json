    {
      "id": "asm-mtd1a82r-5ln9",
      "area": "target_user",
      "decisionKey": "initial_user_count",
      "statement": "系统仅支持严格的“双人绑定”模式，不考虑多设备、多家庭或多人社交的扩展。",
      "reason": "初始想法明确是“独属于我和对象”，限制为双人可以大幅简化权限控制、同步状态和界面设计的复杂度。该设定在产品初期是低风险且合理的。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:15:14.787Z",
      "resolvedAt": "2026-08-28T14:16:31.471Z",
      "resolvedDecisionRef": "decision:dec-1787926591471-i0ne",
      "linkedDecisionRefs": [
        "decision:dec-1787926591471-i0ne"
      ]
    },
    {
      "id": "asm-mtd1a82r-o7z8",
      "area": "page_structure",
      "decisionKey": "browser_based_access",
      "statement": "用户通过主流现代浏览器访问网站，不需要下载安装包。",
      "reason": "网页端开发和分发成本最低，且能够通过添加到主屏幕（PWA）技术实现接近原生应用的体验。如果后续需要原生应用，网页包也很容易打包，是低风险可逆的决定。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:15:14.787Z",
      "resolvedAt": "2026-08-28T14:16:41.266Z",
      "resolvedDecisionRef": "decision:dec-1787926601266-u9ir",
      "linkedDecisionRefs": [
        "decision:dec-1787926601266-u9ir"
      ]
    },
    {
      "id": "asm-mtd1a82r-dbus",
      "area": "core_features",
      "decisionKey": "media_storage_limit",
      "statement": "专属影像馆初期不提供云端大容量存储，以展示本地索引或链接外部媒体源为主。",
      "reason": "存储大体积视频在初期会带来高昂的服务器成本，通过先利用外部链接或本地播放，可以快速验证同步观影的核心体验，以后有需要再升级云存储。",
      "status": "resolved",
      "createdAt": "2026-08-28T14:15:14.787Z",
      "resolvedAt": "2026-08-28T14:16:57.721Z",
      "resolvedDecisionRef": "decision:dec-1787926617721-6uyx",
      "linkedDecisionRefs": [
        "decision:dec-1787926617721-6uyx"
      ]
    },
    {
