    {
      "id": "cand-mtd2j21i-ouuf",
      "area": "technical_boundary",
      "statement": "使用轻量 WebSocket 中转服务进行数据转发，配合本地缓存来实现双人无感状态同步。",
      "status": "confirmed",
      "origin": "user",
      "evidenceRefs": [],
      "decisionKey": "mvp_sync_mechanism",
      "rationale": "基于用户对于“无感数据传输”的需求，使用轻量中转服务器可以在其中一方不在线时暂存其最后的离线状态。这样，当另一方打开网页时，能立刻获取到最新的陪伴状态，用户体验优于纯 P2P 浏览器直连。",
      "createdAt": "2026-08-28T14:50:06.485Z",
      "updatedAt": "2026-08-28T15:11:27.374Z",
      "confirmedBy": "user"
    },
    {
