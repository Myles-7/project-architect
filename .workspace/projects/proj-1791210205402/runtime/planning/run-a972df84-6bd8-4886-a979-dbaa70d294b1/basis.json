        "id": "dec-preset-cli-01",
        "area": "technical_boundary",
        "statement": "支持 --json 格式化输出与管道输入 (stdin NDJSON) 组合使用。",
        "status": "confirmed",
        "origin": "user",
        "evidenceRefs": [],
        "confirmedBy": "user",
        "decisionKey": "pipe_friendly",
        "rationale": "使工具不仅供人类阅读，亦可无缝无损地接入自动化流水线脚本。",
