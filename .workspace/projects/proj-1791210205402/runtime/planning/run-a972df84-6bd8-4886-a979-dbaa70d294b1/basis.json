          "technical_boundary",
          "user_flows"
        ],
        "createdAt": "2026-10-05T14:23:25.402Z",
        "updatedAt": "2026-10-05T14:23:25.402Z"
      },
      {
        "id": "dec-preset-cli-02",
        "area": "user_flows",
        "statement": "首发支持交互式引导 (Interactive Prompt) 与免提示静默标志 (--yes / -y)。",
        "status": "confirmed",
        "origin": "user",
        "evidenceRefs": [],
        "confirmedBy": "user",
        "decisionKey": "headless_ci_support",
        "dependsOn": [
          "dec-preset-cli-01"
        ],
        "rationale": "既能兼顾新手首次配置体验，又能确保无头 CI 环境零挂起。",
        "affectedAreas": [
          "user_flows",
          "mvp_scope"
        ],
