{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionReviewResult",
  "description": "Structured output for decision modification analysis, conflict detection, and ripple effect tracing",
  "type": "object",
  "required": [
    "confirmed",
    "candidates",
    "assumptions",
    "unknowns",
    "risks",
    "conflicts",
    "tensions",
    "gaps",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "confirmed": { "type": "array", "items": { "type": "string" } },
    "candidates": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "reason"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "severity", "reason", "impact", "dependency", "should_ask_user"],
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "reason": { "type": "string" },
          "impact": { "type": "string" },
          "dependency": { "type": "string" },
          "should_ask_user": { "type": "boolean" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["importance", "question", "reason", "recommendation", "recommendation_reason", "options", "allow_free_input"],
        "additionalProperties": false,
        "properties": {
          "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "question": { "type": "string" },
          "reason": { "type": "string" },
          "recommendation": { "type": "string" },
          "recommendation_reason": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "impact"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "impact": { "type": "string" }
              }
            }
          },
          "allow_free_input": { "type": "boolean" }
        }
      }
    }
  }
}
