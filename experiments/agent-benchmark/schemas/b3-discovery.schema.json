{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B3 Planning task result",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "product",
                    "technical",
                    "delivery"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "target",
                    "problem",
                    "outcomes",
                    "scope",
                    "non_goals",
                    "feature",
                    "flow",
                    "page",
                    "technology",
                    "module",
                    "data_model",
                    "interface",
                    "error",
                    "deployment",
                    "task",
                    "acceptance",
                    "validation"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "requirementIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "task": {
                  "type": "object",
                  "properties": {
                    "goal": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "exclusions": {
                      "type": "string"
                    },
                    "modules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "normalBehavior": {
                      "type": "string"
                    },
                    "failureBehavior": {
                      "type": "string"
                    },
                    "verification": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "completionCriteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "environment": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "passCriteria": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidenceRequired": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "onFailure": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "goal",
                    "scope",
                    "exclusions",
                    "modules",
                    "normalBehavior",
                    "failureBehavior",
                    "verification",
                    "completionCriteria",
                    "assumptions"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "stage",
                "kind",
                "title",
                "content",
                "requirementIds",
                "dependsOn",
                "evidenceIds"
              ],
              "additionalProperties": false
            }
          },
          "removeBlockIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "decisionKey": {
                  "type": "string"
                },
                "area": {
                  "type": "string"
                },
                "statement": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "replaces": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "decisionKey",
                "area",
                "statement",
                "rationale",
                "evidenceIds"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "const": "pending"
          },
          "rejectDecisionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "impact",
          "dependsOn",
          "blocks",
          "removeBlockIds",
          "decisions",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "issueRef": {
            "type": "string"
          },
          "importance": {
            "type": "string",
            "enum": [
              "normal",
              "high",
              "critical"
            ]
          },
          "question": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "recommendationReason": {
            "type": "string"
          },
          "recommendedOptionKey": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "approach": {
                  "type": "string"
                },
                "gain": {
                  "type": "string"
                },
                "sacrifice": {
                  "type": "string"
                },
                "impact": {
                  "type": "string"
                },
                "reversibility": {
                  "type": "string",
                  "enum": [
                    "easy",
                    "moderate",
                    "hard"
                  ]
                }
              },
              "required": [
                "key",
                "label",
                "approach",
                "gain",
                "sacrifice",
                "impact",
                "reversibility"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 4
          },
          "allowFreeInput": {
            "type": "boolean",
            "const": true
          },
          "decisionKey": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectionMode": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ]
          },
          "reopenReason": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "proposed"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "issueRef",
          "importance",
          "question",
          "reason",
          "recommendation",
          "recommendationReason",
          "recommendedOptionKey",
          "options",
          "allowFreeInput",
          "decisionKey",
          "dependsOn",
          "status",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "material",
              "official-source",
              "experiment"
            ]
          },
          "content": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "obtainedAt": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "unexecuted",
              "passed",
              "failed",
              "not-applicable"
            ]
          },
          "applicability": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "content",
          "source",
          "obtainedAt",
          "applicability"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "followUp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "research",
              "validation"
            ]
          },
          "goal": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "problem": {
              "type": "string"
            },
            "outcomes": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "constraints": {
              "type": "string"
            },
            "delegated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "target",
            "problem",
            "outcomes",
            "scope",
            "constraints",
            "delegated"
          ],
          "additionalProperties": false
        }
      ]
    },
    "workItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "blockIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "goal",
          "blockIds",
          "dependsOn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "groups",
    "questions",
    "evidence",
    "blockers",
    "followUp",
    "clarification"
  ],
  "additionalProperties": false
}
