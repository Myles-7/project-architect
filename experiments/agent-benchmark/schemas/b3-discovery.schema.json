{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmed", "candidates", "assumptions", "unknowns", "risks", "gaps", "conflicts", "tensions", "questions"],
  "properties": {
    "confirmed": {"type": "array", "items": {"type": "string"}},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_key", "area", "statement", "rationale"],
        "properties": {
          "decision_key": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_key", "area", "statement", "reason"],
        "properties": {
          "decision_key": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_key", "area", "statement", "impact", "severity"],
        "properties": {
          "risk_key": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "tensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["description", "reason"],
        "properties": {"description": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_key", "depends_on", "area", "severity", "reason", "impact", "should_ask_user"],
        "properties": {
          "decision_key": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "area": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "reason": {"type": "string"},
          "impact": {"type": "string"},
          "should_ask_user": {"type": "boolean"}
        }
      }
    },
    "questions": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_key", "depends_on", "importance", "question", "reason", "recommendation", "recommendation_reason", "recommended_option_key", "options", "allow_free_input"],
        "properties": {
          "decision_key": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "importance": {"enum": ["normal", "high", "critical"]},
          "question": {"type": "string"},
          "reason": {"type": "string"},
          "recommendation": {"type": "string"},
          "recommendation_reason": {"type": "string"},
          "recommended_option_key": {"type": "string", "minLength": 1},
          "options": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "label", "impact"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "impact": {"type": "string", "minLength": 1},
                "tradeoffs": {"type": "string"},
                "reversibility": {"enum": ["easy", "moderate", "hard"]}
              }
            }
          },
          "allow_free_input": {"const": true}
        }
      }
    }
  }
}
