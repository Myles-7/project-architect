      "sourceArea": "data_portability"
    },
    {
      "id": "dec-d6ff701c-4666-4605-a6da-ef57a741635e",
      "area": "project_overview",
      "statement": "采用 marked + DOMPurify 轻量安全组合作为便签详情与预览的 Markdown 编译与 XSS 消毒方案，配合 Prism.js 实现代码语法高亮。",
      "decisionKey": "technical.markdown_engine",
      "rationale": "用户已明确委托 AI 拟定 Markdown 解析策略。marked 具有极高的编译性能与仅约 7KB 的超轻量体积，配合工业级 DOMPurify 白名单过滤能够有效防范恶意脚本注入（XSS），并能轻松支持 GitHub Flavored Markdown (GFM) 任务清单复选框交互与代码块高亮，兼顾极速首屏体验与严格的数据安全。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
      "evidenceIds": [
        "evidence-react-official"
      ],
