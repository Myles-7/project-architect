  "items": [
    {
      "id": "dec-01",
      "area": "project_overview",
      "statement": "我想做一个给自己用的本地原型核对页面：上传截图仅作布局参考；文字说明负责行为，不自动把图里的示例文字变成业务需求。只做一个输入项目名、点击确认、展示项目名和清空的单页面。目标是快速核对输入反馈，失败时保留输入。浏览器运行，桌面优先；无需服务端、登录、协作或支付。核心验收：输入任意项目名后可确认显示，空值有提示；具体布局请完整查看截图并描述真实内容。其余普通细节明确委托 AI 拟定，设计建议仍待批准。",
      "status": "candidate",
      "origin": "user",
      "evidenceRefs": [
        "input:inp-01"
      ],
      "createdAt": "2026-10-04T16:06:39.032Z",
      "updatedAt": "2026-10-04T16:06:39.032Z"
    },
    {
      "id": "dec-09b0c6bd-21ae-4e5e-8c2b-8e2893cd4c0d",
      "area": "project_overview",
      "decisionKey": "dec-clear-interaction-mode",
      "statement": "在点击清空按钮时，采用何种重置交互保护机制？\n即时直接清空：用户点击清空按钮后立即复位输入框与展示区，光标自动回焦输入框，不弹出任何阻断式确认框。",
      "rationale": "仅影响清空按钮点击事件的即时处理逻辑，简化状态转移。",
      "status": "confirmed",
      "origin": "user",
      "confirmedBy": "user",
      "approvalSource": "answer:simulated-answer-flash-materials-chinese-20261005-01-1791130366315",
      "evidenceRefs": [
        "question:run-c463e392-91bc-4076-b7fb-514ce507bc3f-delivery-0-ques-clear-confirmation"
      ],
      "createdAt": "2026-10-04T16:12:46.337Z",
      "updatedAt": "2026-10-04T16:12:46.337Z",
      "sourceArea": "交互体验"
    },
    {
      "id": "dec-f958b2fb-9b6f-4a7c-8e9f-b350734c1583",
      "area": "project_overview",
      "statement": "严格限定为纯前端单页面应用，桌面优先，无服务端、无数据库、无用户登录与无协作支付，所有状态仅在客户端内存运行时维护。",
      "decisionKey": "dec-product-scope-boundary",
      "rationale": "依据用户明确约束，个人本地原型核对无需任何服务端支撑与复杂架构，轻量化纯前端运行能实现零部署门槛与即开即用。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
      "evidenceIds": [
        "evidence-27ebc57b-491d-46f1-bdb3-33df17720f9f"
      ],
      "createdAt": "2026-10-04T16:16:26.124Z",
      "updatedAt": "2026-10-04T16:16:26.124Z",
      "approvalSource": "change-c463e392-91bc-4076-b7fb-514ce507bc3f-delivery-1:api-automated-acceptance-flash-materials-chinese-20261005-01-product-1791130586096",
      "sourceArea": "产品范围"
    },
    {
      "id": "dec-f6f1b966-47d4-4308-bc6b-1403c71e1911",
      "area": "project_overview",
      "statement": "在空值提交或任何意外运行时异常时，严格保留输入框内的既有输入文本，仅就地呈现醒目提示，绝不强制抹除用户输入。",
      "decisionKey": "dec-failure-preserve-input",
      "rationale": "用户明确强调‘失败时保留输入’与‘空值有提示’，避免用户在校验失败或异常时重复录入文本，保障本地敏捷核对的高效与连贯。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
      "evidenceIds": [
        "evidence-27ebc57b-491d-46f1-bdb3-33df17720f9f"
      ],
      "createdAt": "2026-10-04T16:16:26.124Z",
      "updatedAt": "2026-10-04T16:16:26.124Z",
      "approvalSource": "change-c463e392-91bc-4076-b7fb-514ce507bc3f-delivery-1:api-automated-acceptance-flash-materials-chinese-20261005-01-product-1791130586096",
      "sourceArea": "交互容错"
    },
    {
      "id": "dec-a91fa65d-c78f-4089-9475-4a3f24ef6d78",
      "area": "project_overview",
      "statement": "项目名展示区必须使用 Node.textContent 属性进行纯文本绑定，严禁使用 innerHTML。",
      "decisionKey": "dec-safe-text-rendering",
      "rationale": "依据 MDN 官方文档规范（evidence-mdn-textcontent-xss-safety），用户输入任意项目名可能包含 HTML 标签或特殊字符，Node.textContent 不调用 HTML 解析器，能够保证文本安全地作为纯文本呈现，从根本上杜绝 DOM 型 XSS 漏洞。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
      "evidenceIds": [
        "evidence-mdn-textcontent-xss-safety",
        "evidence-27ebc57b-491d-46f1-bdb3-33df17720f9f"
      ],
      "createdAt": "2026-10-04T16:16:26.124Z",
      "updatedAt": "2026-10-04T16:16:26.124Z",
      "approvalSource": "change-c463e392-91bc-4076-b7fb-514ce507bc3f-delivery-1:api-automated-acceptance-flash-materials-chinese-20261005-01-product-1791130586096",
      "sourceArea": "显示安全"
    },
    {
      "id": "dec-72513e55-a5a7-44e1-90ad-087b5927447e",
      "area": "project_overview",
      "statement": "采纳 fixture.png 的白底平整背景、顶部显著结果展示区（对应原图黑体字位）、底部左侧蓝色确认按钮（对应原图蓝色矩形）与底部右侧橙色清空按钮（对应原图橙色圆形）的视觉空间排布映射，同时将示例文字 Q7M4-8261 作为纯占位参考而不引入为业务代码依赖。",
      "decisionKey": "dec-visual-layout-mapping",
      "rationale": "忠实还原用户提供的参考截图真实视觉元素与布局结构，同时严格遵守用户‘仅作布局参考；文字说明负责行为，不自动把图里的示例文字变成业务需求’的规则。",
