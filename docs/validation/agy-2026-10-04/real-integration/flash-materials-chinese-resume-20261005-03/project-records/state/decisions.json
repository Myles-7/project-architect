      "sourceArea": "技术栈架构"
    },
    {
      "id": "dec-85156520-0768-4968-9e8e-c0ad9e35a393",
      "area": "project_overview",
      "statement": "采用受控的单向客户端纯内存状态模型管理页面生命周期，不引入任何本地持久化存储。",
      "decisionKey": "dec-tech-in-memory-state",
      "rationale": "契合纯前端本地原型核对的轻量化定位，避免历史缓存与持久化数据污染下一轮测试，保证每次打开页面均具备干净可控的初始就绪态。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
