      "sourceArea": "状态架构"
    },
    {
      "id": "dec-b5363cf6-4c99-493b-816b-92f82b05cd30",
      "area": "project_overview",
      "statement": "交付标准纯静态单页面产物（index.html, styles.css, app.js），完全支持本地无依赖直接双击运行。",
      "decisionKey": "dec-tech-deployment-zero-server",
      "rationale": "极大简化交付复杂度，方便个人开发者使用 Coding Agent 随时直接用浏览器查看与修改代码，无需配置任何 Node.js/Python 复杂构建环境。",
      "status": "confirmed",
