  "items": [
    {
      "id": "dec-01",
      "area": "project_overview",
      "statement": "我想做一个帮自己整理随手灵感的小工具。",
      "status": "candidate",
      "origin": "user",
      "evidenceRefs": [
        "input:inp-01"
      ],
      "createdAt": "2026-10-04T14:57:46.356Z",
