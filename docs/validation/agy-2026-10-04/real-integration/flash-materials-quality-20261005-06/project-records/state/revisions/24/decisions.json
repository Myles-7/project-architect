    },
    {
      "id": "dec-f958b2fb-9b6f-4a7c-8e9f-b350734c1583",
      "area": "project_overview",
      "statement": "严格限定为纯前端单页面应用，桌面优先，无服务端、无数据库、无用户登录与无协作支付，所有状态仅在客户端内存运行时维护。",
      "decisionKey": "dec-product-scope-boundary",
      "rationale": "依据用户明确约束，个人本地原型核对无需任何服务端支撑与复杂架构，轻量化纯前端运行能实现零部署门槛与即开即用。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
