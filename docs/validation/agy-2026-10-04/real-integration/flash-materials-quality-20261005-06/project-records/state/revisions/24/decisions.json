    {
      "id": "dec-a91fa65d-c78f-4089-9475-4a3f24ef6d78",
      "area": "project_overview",
      "statement": "项目名展示区必须使用 Node.textContent 属性进行纯文本绑定，严禁使用 innerHTML。",
      "decisionKey": "dec-safe-text-rendering",
      "rationale": "依据 MDN 官方文档规范（evidence-mdn-textcontent-xss-safety），用户输入任意项目名可能包含 HTML 标签或特殊字符，Node.textContent 不调用 HTML 解析器，能够保证文本安全地作为纯文本呈现，从根本上杜绝 DOM 型 XSS 漏洞。",
      "status": "superseded",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
