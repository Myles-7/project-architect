    {
      "id": "dec-f6f1b966-47d4-4308-bc6b-1403c71e1911",
      "area": "project_overview",
      "statement": "在空值提交或任何意外运行时异常时，严格保留输入框内的既有输入文本，仅就地呈现醒目提示，绝不强制抹除用户输入。",
      "decisionKey": "dec-failure-preserve-input",
      "rationale": "用户明确强调‘失败时保留输入’与‘空值有提示’，避免用户在校验失败或异常时重复录入文本，保障本地敏捷核对的高效与连贯。",
      "status": "confirmed",
      "origin": "agent",
      "confirmedBy": "user",
      "evidenceRefs": [],
